# Copy to .env for local runs. On the fleet host this lives in
# ~/.config/fleet/birdlisten.env instead. Never commit .env.

# name=rtsp-url pairs, comma separated. Reolink: use the sub-stream (smaller
# video, same audio). Older firmware: /h264Preview_01_sub   Newer: /Preview_01_sub
# The camera's "Record Audio" setting must be ON or the stream has no audio.
CAMERAS=front=rtsp://admin:PASSWORD@192.168.1.20:554/h264Preview_01_sub,back=rtsp://admin:PASSWORD@192.168.1.21:554/h264Preview_01_sub

# Your location, for BirdNET's species-by-place-and-season filter.
LATITUDE=47.6
LONGITUDE=-122.3

# Seconds per analyzed segment (min 3). In stream mode every camera listens
# continuously; this sets the analysis window and heard_at granularity.
CLIP_SECONDS=30
# 0..1. 0.5 is a sane default; lower to hear more, raise to trust more.
MIN_CONFIDENCE=0.5

# How cameras are listened to. stream (default): all cameras at once, one
# long-lived ffmpeg each, one BirdNET worker. roundrobin: the old passes, one
# camera at a time (use it if the NVR refuses concurrent sessions).
# CAPTURE_MODE=stream
# Clips waiting for analysis before the oldest is dropped. Empty = 2 x cameras.
# QUEUE_SIZE=
# Minutes between "timing summary" log lines.
# SUMMARY_MINUTES=5
# In-flight WAV segments (about 3 MB each, deleted after analysis). Not DATA_DIR.
# SEGMENT_DIR=/tmp/birdlisten-segments

# Keep the WAV of clips that had a detection under /data/clips/YYYY-MM-DD/.
KEEP_CLIPS=0

# Optional push notifications via ntfy.sh (free, phone app, no account).
# The topic IS the password: use something unguessable.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Don't re-notify the same species within this many minutes.
NOTIFY_COOLDOWN_MIN=60

TZ=America/Los_Angeles
# Optional HTTP collage page for Home Assistant (see README). Unset = off.
# SERVE_PORT=8085
# COLLAGE_HOURS=24
# ARTWORK_DIR=/data/artwork
# ARTWORK_REF=8e8b0034f069b4d3b021bc7195482c1fe7caf880
# Audubon plates (Wikimedia Commons) for species Fugleramme lacks; 0 to turn off.
# AUDUBON_FALLBACK=1
# Pop-up facts (Wikidata, Wikipedia, eBird), cached under FACTS_DIR. 0 = cache only.
# FACTS_FETCH=1
# FACTS_DIR=/data/facts
# eBird API key (secret): species codes and nearby reports. Leave empty here;
# on the fleet host it lives in ~/.config/fleet/birdlisten.env. Never commit it.
# EBIRD_API_KEY=
